# ── Base de datos ────────────────────────────────────────────────────
# En Railway: añade Postgres al proyecto y aquí pon ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:clave@localhost:5432/escritorio

# ── Panel de administración (/admin) ─────────────────────────────────
# La contraseña con la que subes fotos. Larga, y sólo tuya.
ADMIN_PASSWORD=pon-aqui-una-contrasena-larga
# Firma la sesión. Genera una con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-algo-aleatorio-y-largo

# ── Cloudflare R2 (donde viven las fotos) ────────────────────────────
# Panel de Cloudflare → R2 → «Manage API tokens» → crea uno con permiso
# de lectura y escritura sobre el bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=escritorio-fotos
# El dominio público del bucket, sin barra final. Puede ser el r2.dev que
# Cloudflare te da al activar «Public access», o tu propio subdominio.
R2_PUBLIC_URL=https://fotos.tudominio.com

# ── Opcionales ───────────────────────────────────────────────────────
PORT=3000
# Tamaño máximo por archivo subido, en MB. Un RAW de 4K cabe de sobra en 60.
MAX_UPLOAD_MB=60
LOG_LEVEL=info
# RUN_MIGRATIONS=0 desactiva la creación del esquema al arrancar
